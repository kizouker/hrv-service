# Copy to .env and adjust for local development. Never commit .env.
# PostgreSQL (docker compose: postgres-tjänsten; host-port nås via POSTGRES_PORT)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
APP_PORT=8080

# JDBC-bas för körningar på host (IDE, mvn). Inuti compose-containern
# override:as den av app-tjänstens DATABASE_URL (postgres:5432).
DATABASE_URL=jdbc:postgresql://localhost:5432

# Security
JWT_SECRET=
JWT_EXPIRATION_MS=86400000


# Om appen har externa tjänster
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# API_KEY=
# Generate a new jwt openssl rand -base64 48
